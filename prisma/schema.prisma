generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Class {
  id        String    @id @default(cuid())
  name      String
  subjects  Subject[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
}

model Subject {
  id        String    @id @default(cuid())
  classId   String
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String
  chapters  Chapter[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([classId])
}

model Chapter {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  topics    Topic[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([subjectId])
}

model Topic {
  id               String            @id @default(cuid())
  chapterId        String
  chapter          Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  name             String
  rawText          String            @db.Text
  status           String            @default("draft") // draft | chunked | embedding | embedded | failed
  failureReason    String?
  chunks           Chunk[]
  trainingExamples TrainingExample[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt

  @@index([chapterId])
}

model Chunk {
  id              String                      @id @default(cuid())
  topicId         String
  topic           Topic                       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  text            String                      @db.Text
  chunkOrder      Int
  tokenCount      Int
  page            Int?
  editable        Boolean                     @default(true)
  embeddingStatus String                      @default("pending") // pending | embedded | failed
  embedding       Unsupported("vector(768)")?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @default(now()) @updatedAt

  @@index([topicId])
}

model TrainingExample {
  id          String   @id @default(cuid())
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type        String // qna | mcq | srijonsil | evaluation | multi_explain
  instruction String   @db.Text
  input       String   @db.Text
  output      String   @db.Text
  metadata    Json?
  status      String   @default("generated") // generated | approved | rejected
  reviewNotes String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([topicId])
}

model TrainingDataset {
  id             String        @id @default(cuid())
  name           String
  filterCriteria Json
  exampleCount   Int
  jsonlPath      String?
  log            String?       @db.Text
  exportedAt     DateTime?
  jobs           TrainingJob[]
  createdAt      DateTime      @default(now())
}

model TrainingJob {
  id          String          @id @default(cuid())
  datasetId   String
  dataset     TrainingDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  baseModel   String
  status      String          @default("queued") // queued | running | completed | failed
  adapterPath String?
  modelTag    String?
  logs        String?         @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([datasetId])
}
