DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pathtrain?schema=public"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme"
# HMAC key for the admin session cookie. Falls back to ADMIN_PASSWORD, which
# invalidates every session whenever the password changes — set it explicitly.
SESSION_SECRET=""
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b-instruct"
OLLAMA_FINETUNED_MODEL="pathtrain-ft"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
# Interpreter used to launch training-service/train.py
PYTHON_PATH=""
